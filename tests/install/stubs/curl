#!/bin/sh
# Stub: logs the call and writes a small file where -o points, so a
# "download" never touches the network and can never match a pin.
echo "curl $*" >>"${FAKE_LOG:-/dev/null}"
out=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-o" ]; then out=$2; shift; fi
  shift
done
[ -n "$out" ] && printf 'not a release\n' >"$out"
exit "${FAKE_CURL_RC:-0}"
