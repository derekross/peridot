[Unit]
Description=Peridot: keeps your Omarchy computers matching
Documentation=https://github.com/derekross/peridot
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/peridotd
Restart=on-failure
RestartSec=3

# Hardening. Peridot writes the settings it syncs (in ~/.config, and
# ~/.XCompose / ~/.bashrc if you sync them), so your home folder stays
# writable; the rest of the system is read-only. It needs the session bus
# (keyring) and the network; installing a theme or plugin you accepted runs
# through systemd-run, outside this sandbox.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h %t
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# Your key lives in this process: never write core dumps.
LimitCORE=0
UMask=0022

[Install]
WantedBy=graphical-session.target
