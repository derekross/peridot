# Installed by Peridot (https://github.com/derekross/peridot); install.sh and
# uninstall.sh only replace or remove this file while this line is here.
#
# One Omarchy install (a theme, a plugin, or a theme switch) that Peridot's
# daemon asked for over peridot-install.socket and you confirmed in the
# panel. One instance per connection: it reads the request from the socket,
# checks it and the panel's consent record, runs the matching Omarchy
# command with a small environment of its own, and answers on the socket.
[Unit]
Description=Peridot: Omarchy install (%i)
Documentation=https://github.com/derekross/peridot
CollectMode=inactive-or-failed

[Service]
ExecStart=%h/.local/bin/peridot-install
StandardInput=socket
StandardOutput=socket
StandardError=journal
# From systemd's own record of you, not from anything a caller could set.
Environment=HOME=%h USER=%u LOGNAME=%u XDG_RUNTIME_DIR=%t
# Omarchy's installers need your session (the display, the bus, git), so
# this unit isn't sandboxed beyond this; it can't gain privileges.
NoNewPrivileges=yes
RuntimeMaxSec=300
